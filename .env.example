# Leave empty for local development. Production requires a generated secret.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

DB_ENGINE=sqlite
# For MySQL, set DB_ENGINE=mysql and configure these values:
# DB_NAME=hms_db
# DB_USER=your_mysql_user
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
